+def wayfern_identity(base: dict, persona: dict) -> dict:
+    """Map the browser-visible subset onto Wayfern's identity document."""
+    out = json.loads(json.dumps(base))
+    out["operatingSystem"] = "macos"
+    out["language"] = persona["locale"]
+    out["timezone"] = persona["timezone"]
+    ov = out.get("overrides")
+    if isinstance(ov, str):
+        try: ov = json.loads(ov)
+        except Exception: ov = {}
+    if not isinstance(ov, dict): ov = {}
+    ov["hardwareConcurrency"] = persona["logical_cpus"]
+    ov["deviceMemory"] = min(max(persona["ram_gb"], 1), 8)
+    # Keep the local CJK/emoji restriction: enumerate only macOS Latin families.
+    ov["fonts"] = json.dumps([
+        "Arial","Arial Black","Courier New","Georgia","Impact","Tahoma",
+        "Times New Roman","Trebuchet MS","Verdana","Helvetica","Helvetica Neue",
+        "Menlo","Monaco",
+    ])
+    out["overrides"] = ov
+    out["vm2api_persona"] = {
+        "vm_id": persona["vm_id"], "model": persona["model_identifier"],
+        "serial": persona["serial_number_12"], "mlb": persona["mlb_serial_17"],
+        "hardware_uuid": persona["hardware_uuid"], "rom": persona["rom_hex"],
+        "hostname": persona["hostname"], "machine_id": persona["machine_id"],
+    }
+    return out
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Generate a VM2API macOS persona")
+    ap.add_argument("--vm-id", required=True)
+    ap.add_argument("--out", help="write persona JSON here")
+    ap.add_argument("--identity", help="Wayfern identity JSON to update")
+    ap.add_argument("--identity-out", help="write updated identity here")
+    ap.add_argument("--timezone", default="America/Denver")
+    ap.add_argument("--locale", default="en-US")
+    args = ap.parse_args(argv)
+    persona = generate(args.vm_id, args.timezone, args.locale)
+    if args.out:
+        Path(args.out).write_text(json.dumps(persona, indent=2, ensure_ascii=False) + "\n")
+    if args.identity:
+        base = json.loads(Path(args.identity).read_text())
+        upd = wayfern_identity(base, persona)
+        dest = args.identity_out or args.identity
+        Path(dest).write_text(json.dumps(upd, indent=2, ensure_ascii=False) + "\n")
+    print(json.dumps({k: persona[k] for k in ("vm_id","source_profile","model_identifier","serial_number_12","mlb_serial_17","hardware_uuid","mac","hostname","machine_id")}, indent=2))
+
+if __name__ == "__main__":
+    main()
