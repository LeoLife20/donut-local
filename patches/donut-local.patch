new file mode 100755
index 0000000..49cf92f
--- /dev/null
+++ b/tools/donut-fingerprint/validate_windows.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+import json, sys
+from pathlib import Path
+ROOT = Path(__file__).resolve().parent
+RUNTIME = Path.home() / "Library/Application Support/DonutBrowserLocalRuntime"
+PROFILES = RUNTIME / "data/profiles"
+personas = {p.stem: json.loads(p.read_text()) for p in (ROOT/"personas").glob("*.json")}
+reg = json.loads((ROOT/"windows.json").read_text())
+seen_ids=set(); seen_personas=set(); bad=0
+for w in reg["windows"]:
+    d = PROFILES / w["profile_id"]
+    meta = json.loads((d/"metadata.json").read_text())
+    cfg = meta.get("wayfern_config") or {}
+    ov = json.loads(cfg.get("identity_overrides") or "{}")
+    p = personas[w["persona_id"]]
+    h,b,wg = p["hardware"], p["browser"], p["webgl"]
+    errs=[]
+    if cfg.get("identity_id") in seen_ids: errs.append("duplicate identity_id")
+    seen_ids.add(cfg.get("identity_id"))
+    if w["persona_id"] in seen_personas: errs.append("duplicate persona")
+    seen_personas.add(w["persona_id"])
+    if cfg.get("randomize_fingerprint_on_launch"): errs.append("randomize enabled")
+    if "devicePixelRatio" in ov: errs.append("devicePixelRatio override (rejected)")
+    if ov.get("hardwareConcurrency") != h["threads"]: errs.append("threads mismatch")
+    if [ov.get("screenWidth"),ov.get("screenHeight")] != h["screen"]: errs.append("screen mismatch")
+    if [ov.get("screenAvailWidth"),ov.get("screenAvailHeight")] != h["avail"]: errs.append("avail mismatch")
+    if h.get("gpu","").split()[-1] not in ov.get("webglRenderer",""): errs.append("renderer mismatch")
+    if ov.get("platformVersion") != b["platform_version"]: errs.append("platformVersion mismatch")
+    if "zh-CN" in (ov.get("fonts") or ""): errs.append("CJK font in list")
+    loc = json.loads(cfg.get("location") or "{}")
+    if loc.get("timezone") != p["locale"]["timezone"]: errs.append("timezone mismatch")
+    if not wg.get("parameters"): errs.append("WARN webglParameters empty (host caps still leak)")
+    status = "OK" if not any(not e.startswith("WARN") for e in errs) else "FAIL"
+    if status=="FAIL": bad+=1
+    print(f'{status:4}  {w["name"]:<8} persona={w["persona_id"]:<32} ' + "; ".join(errs))
+print(f"\n{len(reg["windows"])} windows, {bad} fail")
+sys.exit(1 if bad else 0)
