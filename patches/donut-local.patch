+test("manual profile timezones validate, persist, clone, and restore the automatic location", async () => {
+  await withApp("entities-manual-timezone", async (app) => {
+    const profile = await createProfile(app, "Manual Timezone");
+    const originalConfig = profile.wayfern_config;
+    await app.invoke("update_wayfern_config", {
+      profileId: profile.id,
+      config: { ...originalConfig, timezone_override: "  Asia/Shanghai  " },
+    });
+    const current = async () =>
+      (await app.invoke("list_browser_profiles")).find(
+        (p) => p.id === profile.id,
+      );
+    assert.equal(
+      (await current()).wayfern_config.timezone_override,
+      "Asia/Shanghai",
+    );
+    assert.equal(
+      (await current()).wayfern_config.fingerprint,
+      originalConfig.fingerprint,
+    );
+    assert.equal(
+      (await current()).wayfern_config.location,
+      originalConfig.location,
+    );
+    const clone = await app.invoke("clone_profile", {
+      profileId: profile.id,
+      name: "Cloned Manual Timezone",
+    });
+    assert.equal(clone.wayfern_config.timezone_override, "Asia/Shanghai");
+    await app.close();
+    await app.start();
+    assert.equal(
+      (await current()).wayfern_config.timezone_override,
+      "Asia/Shanghai",
+    );
+    for (const timezone of ["Unknown/Zone", "GMT+8", "", "  "]) {
+      const error = await app.invokeError("update_wayfern_config", {
+        profileId: profile.id,
+        config: {
+          ...(await current()).wayfern_config,
+          timezone_override: timezone,
+        },
+      });
+      assert.match(error, /"code":"INVALID_TIMEZONE_OVERRIDE"/);
+      assert.equal(
+        (await current()).wayfern_config.timezone_override,
+        "Asia/Shanghai",
+      );
+    }
+    await app.invoke("update_wayfern_config", {
+      profileId: profile.id,
+      config: { ...(await current()).wayfern_config, timezone_override: null },
+    });
+    assert.equal(
+      (await current()).wayfern_config.timezone_override ?? null,
+      null,
+    );
+    assert.equal(
+      (await current()).wayfern_config.fingerprint,
+      originalConfig.fingerprint,
+    );
+    assert.equal(
+      (await app.invoke("list_browser_profiles")).find((p) => p.id === clone.id)
+        .wayfern_config.timezone_override,
+      "Asia/Shanghai",
+    );
+    const created = await app.invoke("create_browser_profile_new", {
+      name: "Created With Manual Timezone",
+      browserStr: "wayfern",
+      version: profile.version,
+      releaseType: "stable",
+      proxyId: null,
+      vpnId: null,
+      wayfernConfig: { fingerprint: "{}", timezone_override: "Asia/Kathmandu" },
+      groupId: null,
+      ephemeral: false,
+      dnsBlocklist: null,
+      launchHook: null,
+    });
+    assert.equal(created.wayfern_config.timezone_override, "Asia/Kathmandu");
+  });
+});
