diff --git a/src-tauri/src/persona.rs b/src-tauri/src/persona.rs
new file mode 100644
index 0000000..69770fc
--- /dev/null
+++ b/src-tauri/src/persona.rs
@@ -0,0 +1,143 @@
+//! Device personas used when a new Wayfern profile is created.
+//!
+//! The pool is a set of real machine configurations. A profile is assigned
+//! exactly one persona at creation; the persona id is stored in the profile's
+//! `wayfern_config.device_persona_id` and is never regenerated on launch.
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Map, Value};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PersonaHardware {
+  pub model: String,
+  pub cpu: String,
+  pub threads: u32,
+  pub ram_gb: u32,
+  pub gpu: String,
+  pub screen: Vec<u32>,
+  pub avail: Vec<u32>,
+  pub color_depth: u32,
+  pub dpr: u32,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PersonaBrowser {
+  pub ua: String,
+  pub platform: String,
+  pub platform_version: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PersonaWebgl {
+  pub vendor: String,
+  pub renderer: String,
+  #[serde(default)]
+  pub parameters: Map<String, Value>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Persona {
+  pub persona_id: String,
+  pub os: String,
+  pub hardware: PersonaHardware,
+  pub browser: PersonaBrowser,
+  pub webgl: PersonaWebgl,
+  pub fonts: Vec<String>,
+  #[serde(default)]
+  pub do_not_track: Option<String>,
+}
+
+fn pool() -> Vec<Persona> {
+  serde_json::from_str::<Vec<Persona>>(include_str!("../personas/personas.json"))
+    .unwrap_or_default()
+}
+
+/// Pick an unused persona for the claimed OS. A device whose base identity
+/// already reports this DPR is preferred, because `devicePixelRatio` is not a
+/// legal identity override (sending it rejects the whole override set).
+pub fn select(os: &str, dpr: u32, used: &std::collections::HashSet<String>) -> Option<Persona> {
+  let all = pool();
+  let candidates: Vec<&Persona> = all
+    .iter()
+    .filter(|p| p.os == os && !used.contains(&p.persona_id))
+    .collect();
+  candidates
+    .iter()
+    .find(|p| p.hardware.dpr == dpr)
+    .or_else(|| candidates.first())
+    .map(|p| (*p).clone())
+}
+
+impl Persona {
+  pub fn overrides(&self) -> Map<String, Value> {
+    let h = &self.hardware;
+    let b = &self.browser;
+    let w = &self.webgl;
+    let mut out = Map::new();
+    out.insert("hardwareConcurrency".into(), json!(h.threads));
+    out.insert("deviceMemory".into(), json!(h.ram_gb.min(8).max(1)));
+    if let (Some(width), Some(height)) = (h.screen.first(), h.screen.get(1)) {
+      out.insert("screenWidth".into(), json!(width));
+      out.insert("screenHeight".into(), json!(height));
+    }
+    if let (Some(width), Some(height)) = (h.avail.first(), h.avail.get(1)) {
+      out.insert("screenAvailWidth".into(), json!(width));
+      out.insert("screenAvailHeight".into(), json!(height));
+    }
+    out.insert("screenColorDepth".into(), json!(h.color_depth));
+    out.insert("platform".into(), json!(b.platform));
+    out.insert("platformVersion".into(), json!(b.platform_version));
+    out.insert("userAgent".into(), json!(b.ua));
+    out.insert("maxTouchPoints".into(), json!(0));
+    out.insert("webglVendor".into(), json!(w.vendor));
+    out.insert("webglRenderer".into(), json!(w.renderer));
+    out.insert(
+      "doNotTrack".into(),
+      json!(self.do_not_track.as_deref().unwrap_or("unspecified")),
+    );
+    out.insert("fonts".into(), json!(serde_json::to_string(&self.fonts).unwrap_or_default()));
+    if !w.parameters.is_empty() {
+      out.insert(
+        "webglParameters".into(),
+        json!(serde_json::to_string(&w.parameters).unwrap_or_default()),
+      );
+    }
+    out
+  }
+
+  pub fn overrides_json(&self) -> Result<String, serde_json::Error> {
+    serde_json::to_string(&self.overrides())
+  }
+}
+
+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  #[test]
+  fn pool_has_macos_personas() {
+    let all = pool();
+    assert!(all.len() >= 4);
+    assert!(all.iter().all(|p| p.os == "macos"));
+  }
+
+  #[test]
+  fn select_prefers_matching_dpr_and_never_reuses() {
+    let used = std::collections::HashSet::new();
+    let p2 = select("macos", 2, &used).expect("dpr2 persona");
+    assert_eq!(p2.hardware.dpr, 2);
+    let mut used2 = used.clone();
+    used2.insert(p2.persona_id.clone());
+    let p1 = select("macos", 1, &used2).expect("dpr1 persona");
+    assert_eq!(p1.hardware.dpr, 1);
+    assert_ne!(p1.persona_id, p2.persona_id);
+  }
+
+  #[test]
+  fn overrides_have_no_device_pixel_ratio() {
+    let p = select("macos", 2, &std::collections::HashSet::new()).unwrap();
+    let o = p.overrides();
+    assert!(!o.contains_key("devicePixelRatio"));
+    assert_eq!(o["hardwareConcurrency"], json!(p.hardware.threads));
+  }
+}
