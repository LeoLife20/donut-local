new file mode 100644
index 0000000..0ae36f8
--- /dev/null
+++ b/tools/vm2api-persona/collector.html
@@ -0,0 +1,53 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Device / WebGL persona collector</title>
+<style>body{font:13px/1.45 -apple-system,system-ui,sans-serif;margin:24px;max-width:1100px}textarea{width:100%;height:60vh;font:12px/1.4 ui-monospace,Menlo,monospace}button{padding:6px 12px;margin:8px 0}</style>
+<h2>Device / WebGL persona collector</h2>
+<p>Run this page on a <b>real</b> machine, in the exact browser/OS you want to emulate. Copy the JSON into <code>personas/&lt;id&gt;.json</code>.</p>
+<button id="copy">Copy JSON</button>
+<textarea id="out" readonly></textarea>
+<script>
+const P1 = ["VENDOR","RENDERER","VERSION","SHADING_LANGUAGE_VERSION","MAX_TEXTURE_SIZE","MAX_CUBE_MAP_TEXTURE_SIZE","MAX_RENDERBUFFER_SIZE","MAX_VIEWPORT_DIMS","MAX_VERTEX_ATTRIBS","MAX_VERTEX_UNIFORM_VECTORS","MAX_FRAGMENT_UNIFORM_VECTORS","MAX_VARYING_VECTORS","MAX_COMBINED_TEXTURE_IMAGE_UNITS","MAX_VERTEX_TEXTURE_IMAGE_UNITS","MAX_TEXTURE_IMAGE_UNITS","MAX_TEXTURE_MAX_ANISOTROPY_EXT","ALIASED_LINE_WIDTH_RANGE","ALIASED_POINT_SIZE_RANGE","RED_BITS","GREEN_BITS","BLUE_BITS","ALPHA_BITS","DEPTH_BITS","STENCIL_BITS","SUBPIXEL_BITS","MAX_ELEMENT_INDEX","MAX_ELEMENTS_INDICES","MAX_ELEMENTS_VERTICES","MAX_FRAGMENT_UNIFORM_COMPONENTS","MAX_VERTEX_UNIFORM_COMPONENTS","MAX_VERTEX_OUTPUT_COMPONENTS","MAX_FRAGMENT_INPUT_COMPONENTS","MAX_SAMPLES","MAX_COLOR_ATTACHMENTS","MAX_DRAW_BUFFERS"];
+const P2 = ["MAX_3D_TEXTURE_SIZE","MAX_ARRAY_TEXTURE_LAYERS","MAX_TEXTURE_LOD_BIAS","MAX_UNIFORM_BUFFER_BINDINGS","MAX_UNIFORM_BLOCK_SIZE","MAX_VERTEX_UNIFORM_BLOCKS","MAX_FRAGMENT_UNIFORM_BLOCKS","MAX_COMBINED_UNIFORM_BLOCKS","MAX_TRANSFORM_FEEDBACK_SEPARATE_ATTRIBS","MAX_TRANSFORM_FEEDBACK_SEPARATE_COMPONENTS","MAX_TRANSFORM_FEEDBACK_INTERLEAVED_COMPONENTS","MAX_TRANSFORM_FEEDBACK_BUFFERS","MAX_VERTEX_ATTRIB_RELATIVE_OFFSET","MAX_ELEMENT_INDEX","MAX_ELEMENTS_INDICES","MAX_ELEMENTS_VERTICES","MAX_SAMPLES","MAX_COLOR_ATTACHMENTS","MAX_DRAW_BUFFERS","MAX_CLIENT_WAIT_TIMEOUT_WEBGL"];
+function val(v){ if (v && typeof v.length === 'number' && typeof v !== 'string') return Array.from(v); return v; }
+function dump(gl, names){
+  const o = { parameters:{}, extensions:[], precision:{} };
+  if (!gl) return o;
+  for (const n of names) { try { const p = gl[n]; if (p !== undefined) o.parameters[n] = val(gl.getParameter(p)); } catch(e){} }
+  try { o.extensions = gl.getSupportedExtensions() || []; } catch(e){}
+  for (const [s,label] of [[gl.VERTEX_SHADER,'vertex'],[gl.FRAGMENT_SHADER,'fragment']]) {
+    try { const p = gl.getShaderPrecisionFormat(s, gl.HIGH_FLOAT); o.precision[label] = p ? {rangeMin:p.rangeMin,rangeMax:p.rangeMax,precision:p.precision} : null; } catch(e){}
+  }
+  try { const e = gl.getExtension('WEBGL_debug_renderer_info'); if (e) { o.unmaskedVendor = gl.getParameter(e.UNMASKED_VENDOR_WEBGL); o.unmaskedRenderer = gl.getParameter(e.UNMASKED_RENDERER_WEBGL); } } catch(e){}
+  return o;
+}
+function fontFingerprint(){
+  const c=document.createElement('canvas'), x=c.getContext('2d'); const fonts=["Arial","Arial Black","Helvetica","Helvetica Neue","Menlo","Monaco","Times New Roman","Georgia","Courier New","Verdana","Tahoma","Trebuchet MS","Impact","Comic Sans MS","Segoe UI","Roboto","PingFang SC","Hiragino Sans","Microsoft YaHei","SimSun"];
+  const base="mmmmmmmmmmlli"; const res={};
+  x.font="72px monospace"; const mono=x.measureText(base).width;
+  x.font="72px sans-serif"; const sans=x.measureText(base).width;
+  for(const f of fonts){ x.font=`72px "${f}", monospace`; const a=x.measureText(base).width; x.font=`72px "${f}", sans-serif`; const b=x.measureText(base).width; res[f]={mono:a!==mono,sans:b!==sans}; }
+  return res;
+}
+async function media(){
+  try { const d=await navigator.mediaDevices.enumerateDevices(); return d.map(x=>({kind:x.kind,label:x.label,deviceId:x.deviceId.slice(0,8),groupId:x.groupId.slice(0,8)})); } catch(e){ return String(e); }
+}
+(async()=>{
+  const c=document.createElement('canvas');
+  const gl1=c.getContext('webgl',{failIfMajorPerformanceCaveat:false});
+  const gl2=document.createElement('canvas').getContext('webgl2',{failIfMajorPerformanceCaveat:false});
+  const out={
+    collected_at:new Date().toISOString(),
+    navigator:{userAgent:navigator.userAgent,platform:navigator.platform,language:navigator.language,languages:navigator.languages,hardwareConcurrency:navigator.hardwareConcurrency,deviceMemory:navigator.deviceMemory,maxTouchPoints:navigator.maxTouchPoints,webdriver:navigator.webdriver},
+    uaData:navigator.userAgentData?{brands:navigator.userAgentData.brands,platform:navigator.userAgentData.platform,platformVersion:navigator.userAgentData.platformVersion,mobile:navigator.userAgentData.mobile}:null,
+    screen:{width:screen.width,height:screen.height,availWidth:screen.availWidth,availHeight:screen.availHeight,colorDepth:screen.colorDepth,pixelDepth:screen.pixelDepth,devicePixelRatio:devicePixelRatio,orientation:screen.orientation&&screen.orientation.type},
+    window:{innerWidth:innerWidth,innerHeight:innerHeight,outerWidth:outerWidth,outerHeight:outerHeight},
+    timezone:Intl.DateTimeFormat().resolvedOptions().timeZone,locale:Intl.DateTimeFormat().resolvedOptions().locale,
+    webgl1:dump(gl1,P1),webgl2:dump(gl2,P2),
+    fonts:fontFingerprint(),media:await media(),
+    canvas_hash:(()=>{try{const x=c.getContext('2d');x.textBaseline='top';x.font='14px Arial';x.fillStyle='#f60';x.fillRect(125,1,62,20);x.fillStyle='#069';x.fillText('fingerprint',2,15);return c.toDataURL().slice(-64);}catch(e){return String(e)}})()
+  };
+  document.getElementById('out').value=JSON.stringify(out,null,2);
+  document.getElementById('copy').onclick=()=>navigator.clipboard.writeText(document.getElementById('out').value);
+})();
+</script>
