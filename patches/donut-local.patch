+  }
+
+  #[test]
+  fn timezone_offsets_follow_iana_dst_and_date_offset_signs() {
+    let winter = "2026-01-15T12:00:00Z"
+      .parse::<chrono::DateTime<chrono::Utc>>()
+      .unwrap();
+    let summer = "2026-07-15T12:00:00Z"
+      .parse::<chrono::DateTime<chrono::Utc>>()
+      .unwrap();
+    assert_eq!(
+      WayfernManager::timezone_offset_minutes_at("America/New_York", winter),
+      Some(300)
+    );
+    assert_eq!(
+      WayfernManager::timezone_offset_minutes_at("America/New_York", summer),
+      Some(240)
+    );
+    assert_eq!(
+      WayfernManager::timezone_offset_minutes_at("Asia/Shanghai", summer),
+      Some(-480)
+    );
+    assert_eq!(
+      WayfernManager::timezone_offset_minutes_at("Asia/Kathmandu", summer),
+      Some(-345)
+    );
+    assert_eq!(
+      WayfernManager::timezone_offset_minutes_at("UTC", summer),
+      Some(0)
+    );
+    assert_eq!(
+      WayfernManager::timezone_offset_minutes_at("Invalid/Timezone", summer),
+      None
+    );
+  }
