+  pub fn with_timezone_override(&self) -> Result<Self, String> {
+    let mut effective = self.clone();
+    // Overrides are only sent when the caller asked for them. Sending a font
+    // list the engine did not generate counts as a fingerprint edit and is
+    // withheld without a Wayfern token, which aborts the launch. The
+    // enumeration layer (DonutFontPolicy.dylib) already hides CJK and emoji
+    // from the engine, so its own generated identity is Latin-only without an
