+        "cpu_brand": p.cpu_brand, "cpu_family": p.cpu_family, "cpu_model": p.cpu_model,
+        "cpu_stepping": p.cpu_stepping, "physical_cores": p.physical_cores, "logical_cpus": p.logical_cpus,
+        "ram_gb": p.ram_gb, "ram_bytes": p.ram_gb * 1024**3,
+        "dimms": p.dimms,
+        "disk_model": a.disk_model, "disk_serial": disk_serial, "disk_firmware": a.disk_firmware,
+        "macos_product_name": "macOS", "macos_product_version": "14.5", "macos_build_version": "23F79",
