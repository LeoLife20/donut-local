+    );
+    let mut automatic = config.clone();
+    automatic.timezone_override = None;
+    assert_eq!(
+      automatic.with_timezone_override().unwrap().location,
+      config.location
+    );
+  }
+
+  #[test]
+  fn manual_timezone_refuses_a_corrupt_fingerprint_without_exposing_it() {
+    let config = WayfernConfig {
+      fingerprint: Some("corrupt stored fingerprint".into()),
+      timezone_override: Some("Asia/Shanghai".into()),
+      ..Default::default()
+    };
+    let error = config.with_timezone_override().unwrap_err();
+    assert_eq!(
+      serde_json::from_str::<serde_json::Value>(&error).unwrap()["code"],
+      "INVALID_FINGERPRINT_CONFIG"
+    );
+    assert!(!error.contains("corrupt stored fingerprint"));
+  }
+
+  #[test]
+  fn manual_timezone_reaches_legacy_and_wrapped_fingerprints() {
+    for fingerprint in [
+      r#"{"timezone":"Europe/Berlin","timezoneOffset":-60,"language":"de-DE","latitude":52.5,"longitude":13.4,"platform":"MacIntel"}"#,
+      r#"{"fingerprint":{"timezone":"Europe/Berlin","timezoneOffset":-60,"language":"de-DE","latitude":52.5,"longitude":13.4,"platform":"MacIntel"}}"#,
+    ] {
+      let config = WayfernConfig {
+        fingerprint: Some(fingerprint.into()),
+        timezone_override: Some("Asia/Shanghai".into()),
+        ..Default::default()
+      };
+      let effective = config.with_timezone_override().unwrap();
+      let payload =
+        WayfernManager::launch_fingerprint_payload(effective.fingerprint.as_deref().unwrap())
+          .unwrap();
+      assert_eq!(payload["timezone"], "Asia/Shanghai");
+      assert_eq!(payload["timezoneOffset"], -480);
+      assert_eq!(payload["platform"], "MacIntel");
+      assert_eq!(payload["language"], "de-DE");
+      assert_eq!(
+        WayfernManager::stored_object(effective.location.as_deref())["language"],
+        "de-DE"
+      );
+      assert_eq!(config.fingerprint.as_deref(), Some(fingerprint));
+    }
+  }
+
+  #[test]
+  fn manual_timezone_can_supply_the_timezone_an_identity_lacks() {
+    let config = WayfernConfig {
+      identity_id: Some("identity-test".into()),
+      timezone_override: Some("UTC".into()),
+      ..Default::default()
+    };
+    let effective = config.with_timezone_override().unwrap();
+    assert_eq!(
+      WayfernManager::launch_identity_document(&effective, "macos").unwrap()["timezone"],
+      "UTC"
+    );
