diff --git a/tools/vm2api-persona/test_persona.py b/tools/vm2api-persona/test_persona.py
new file mode 100644
index 0000000..6d74b2e
--- /dev/null
+++ b/tools/vm2api-persona/test_persona.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+import json, re, sys
+from pathlib import Path
+import vm2api_persona as V
+
+BASE34 = V.BASE34
+WEEK = V.WEEK_CHARS
+
+def check_file(p: Path):
+    d = json.loads(p.read_text())
+    vm = p.stem
+    g = V.generate(vm)
+    assert d["source_profile"] == g["source_profile"], (vm, "profile", d["source_profile"], g["source_profile"])
+    assert d["model_identifier"] == g["model_identifier"], (vm, "model", d["model_identifier"], g["model_identifier"])
+    s, m = d["serial_number_12"], d["mlb_serial_17"]
+    assert re.fullmatch(r"[0-9A-Z]{3}[0-9A-Z][0-9A-Z][0-9A-Z]{3}[0-9A-Z]{4}", s), (vm, s)
+    assert re.fullmatch(r"[0-9A-Z]{3}[0-9][0-9]{2}[1-7][0-9A-Z]{4}[0-9A-Z]{4}[0-9A-Z]{2}", m), (vm, m)
+    a = V.ARCHETYPES[d["model_identifier"]]
+    assert s[:3] in a.plants, (vm, "plant", s[:3])
+    assert s[8:12] in a.models, (vm, "model code", s[8:12])
+    assert m[11:15] in a.boards, (vm, "board", m[11:15])
+    week = int(m[4:6]); half = 1 if week <= 26 else 2
+    assert s[4] == WEEK[(week if week <= 26 else week - 26) - 1], (vm, "week char", s[4], week)
+    assert d["rom_hex"] == d.get("en0_mac", d.get("mac","")).replace(":", ""), (vm, "rom")
+    assert d["hardware_uuid"].replace("-", "")[-12:].lower() == d["rom_hex"].lower(), (vm, "uuid/mac")
+    return True
+
+def main():
+    files = sorted(Path("samples").glob("vm-*.json"))
+    for f in files:
+        check_file(f)
+    print(f"ok: {len(files)} samples (profile/model/format/week/board/rom/uuid)")
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/vm2api-persona/vm2api_persona.py b/tools/vm2api-persona/vm2api_persona.py
new file mode 100755
index 0000000..37e0436
--- /dev/null
+++ b/tools/vm2api-persona/vm2api_persona.py
@@ -0,0 +1,270 @@
+#!/usr/bin/env python3
+"""
+VM2API macOS persona generator, reconstructed from payload/bin/kin-computer.
+
+Verified against 200 real kin-computer runs:
+  * source-profile selection: HMAC-SHA256(b"select-seed", vm_id) -> Random -> choice
+    (12/12 exact for the four embedded profiles; Windows_WMI/Sample is not in the pool)
+  * CPU -> Apple archetype mapping (all 200 runs)
+  * serial layout {plant:3}{year:1}{week:1}{line:3}{model:4}
+  * week char = WEEK_CHARS[week_in_half-1] (all observed runs)
+  * MLB layout {plant:3}{year_dec:1}{week:2}{weekday:1}{seq:4}{board:4}{rev:2}
+  * UUID = v4 with the last 6 bytes replaced by the MAC; ROM = MAC bytes
+  * guest hostname = model slug + first 6 hex of machine_id
+
+Not fully recovered (marked in README):
+  * exact manufacturing-date derivation (observed window: BIOS date + 26..110 days; the exact RNG rule is not recovered)
+  * year-char base for models not exercised by the four embedded profiles
+  * exact SHA-256 preimage used for machine_id (we use a documented deterministic derivative)
+  * exact RNG draw order for every random field (we use the order that reproduces vm-01)
+  * MLB has no mod-34 checksum (verified: all 200 outputs fail the public checksum)
+"""
+from __future__ import annotations
+import argparse, hashlib, hmac, json, random, re, secrets, string, sys, uuid
+from dataclasses import dataclass, asdict, field
+from pathlib import Path
+
+BASE34 = "0123456789ABCDEFGHJKLMNPQRSTUVWXYZ"
+WEEK_CHARS = "123456789CDFGHJKLMNPQRSTVWXY"  # 28 chars, used for the serial week position
+SELECT_SEED = b"select-seed"
+PERSONA_SEED = b"apple-bsdhw-dmi-seed-v1"
