+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  canUseCookieBot,
+  canUseRemoteControl,
+  canUseScheduledAutomation,
+  effectivePlanOf,
+  getEntitlements,
+  getLocalEntitlements,
+  LOCAL_FEATURES_UNRESTRICTED,
+  PRO_UNLOCKED,
+} from "./entitlements.ts";
+
+const free = {
+  id: "free-test-account",
+  plan: "free",
+  subscriptionStatus: "active",
+  profileLimit: 0,
+};
+
+test("the paid local capabilities are unlocked for every account", () => {
+  for (const user of [null, free]) {
+    const ent = getEntitlements(user);
+    assert.equal(ent.active, true);
+    assert.equal(ent.browserAutomation, true);
+    assert.equal(ent.crossOsFingerprints, true);
+    assert.equal(ent.profileLimit, Number.MAX_SAFE_INTEGER);
+    assert.equal(ent.requestsPerHour, 0);
+    assert.equal(canUseCookieBot(user), true);
+    assert.equal(canUseRemoteControl(user), true);
+    assert.equal(canUseScheduledAutomation(user), true);
+    assert.equal(effectivePlanOf(user), "pro");
+  }
+});
+
+test("a local build grants manager capabilities without a cloud plan", () => {
+  for (const user of [null, free]) {
+    assert.deepEqual(getLocalEntitlements(user, true), {
+      unrestricted: true,
+      browserAutomation: true,
+      crossOsFingerprints: true,
+      extensionManagement: true,
+      requestsPerHour: 0,
+    });
+  }
+  assert.equal(free.plan, "free");
+});
+
+test("a signed-in paid account keeps its server-sent cloud capabilities", () => {
+  const server = {
+    active: true,
+    browserAutomation: false,
+    crossOsFingerprints: false,
+    cloudBackup: true,
+    teamCollaboration: false,
+    cookieBot: true,
+    remoteInteractive: false,
+    remoteControl: true,
+    scheduledAutomation: true,
+    profileLimit: 20,
+    requestsPerHour: 0,
+    remoteBrowserHours: 8,
+  };
+  const seat = { ...free, entitlements: server };
+  const ent = getEntitlements(seat);
+  // Server-decided flags survive untouched; the local paid gates are open.
+  assert.equal(ent.cloudBackup, true);
+  assert.equal(ent.remoteControl, true);
+  assert.equal(ent.cookieBot, true);
+  assert.equal(ent.browserAutomation, true);
+  assert.equal(ent.crossOsFingerprints, true);
+  assert.equal(ent.profileLimit, Number.MAX_SAFE_INTEGER);
+});
+
+test("the unlock is unconditional, not env-gated", () => {
+  assert.equal(PRO_UNLOCKED, true);
+  assert.equal(LOCAL_FEATURES_UNRESTRICTED, true);
+  assert.equal(getLocalEntitlements(null).unrestricted, true);
+});
