+def hmac_rng(seed: bytes, vm_id: str) -> random.Random:
+    digest = hmac.new(seed, vm_id.encode(), hashlib.sha256).digest()
+    return random.Random(int.from_bytes(digest, "big"))
+
+def choose_profile(vm_id: str) -> Profile:
+    rng = hmac_rng(SELECT_SEED, vm_id)
+    return PROFILES[rng.randrange(len(PROFILES))]
+
+def map_archetype(p: Profile) -> Archetype:
+    if p.cpu_family == 25:  # AMD
+        return ARCHETYPES["MacPro7,1"]
+    m = p.cpu_model
+    if m == 60:
+        return ARCHETYPES["iMac15,1"] if p.category == "Desktop" else ARCHETYPES["Macmini8,1"]
+    if m == 158:
+        return ARCHETYPES["Macmini8,1"] if p.category != "Notebook" else ARCHETYPES["MacBookPro16,1"]
+    if m in (140, 141, 142):
+        return ARCHETYPES["MacBookPro16,1"] if p.category == "Notebook" else ARCHETYPES["MacPro7,1"]
+    return ARCHETYPES["Macmini8,1"]
+
+def slug(s: str) -> str:
+    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
+
+def random_mac(rng: random.Random) -> str:
+    oui = rng.choice(APPLE_OUIS)
+    tail = [rng.randrange(256) for _ in range(3)]
+    return oui + ":" + ":".join(f"{b:02X}" for b in tail)
+
+def uuid_from_mac(rng: random.Random, mac: str) -> str:
+    b = bytearray(rng.randbytes(16))
+    b[6] = (b[6] & 0x0F) | 0x40
+    b[8] = (b[8] & 0x3F) | 0x80
+    b[10:] = bytes.fromhex(mac.replace(":", ""))
+    return str(uuid.UUID(bytes=bytes(b))).upper()
+
+def iso_weekday(year: int, week: int) -> int:
+    # ISO week 1 Monday; use Jan 4 to anchor the ISO year.
+    import datetime
+    d = datetime.date.fromisocalendar(year, week, 1)
+    return d.isoweekday()
+
+def generate(vm_id: str, seed_timezone: str = "America/Denver", locale: str = "en-US") -> dict:
+    p = choose_profile(vm_id)
+    a = map_archetype(p)
+    rng = hmac_rng(PERSONA_SEED, vm_id)
+    # RNG draw order that reproduces vm-01's serial/MLB exactly.
+    model_code = rng.choice(a.models)
+    plant = rng.choice(a.plants)
+    line = "".join(rng.choice(BASE34) for _ in range(3))
+    seq = "".join(rng.choice(BASE34) for _ in range(4))
+    board_code = rng.choice(a.boards)
+    rev = "".join(rng.choice(BASE34) for _ in range(2))
+    # Manufacturing date: deterministic shift of the profile BIOS date.
+    import datetime
+    try:
+        bios = datetime.datetime.strptime(p.bios_date, "%m/%d/%Y").date()
+    except Exception:
+        bios = datetime.date(2021, 1, 1)
+    mfg = bios + datetime.timedelta(days=rng.randrange(26, 111))
+    iso = mfg.isocalendar()
+    year, week, weekday = iso.year, iso.week, iso.weekday
+    half = 1 if week <= 26 else 2
+    week_in_half = week if week <= 26 else week - 26
+    year_char = a.year_pair[0] if week <= 26 else a.year_pair[1]
+    week_char = WEEK_CHARS[week_in_half - 1]
+    serial = f"{plant}{year_char}{week_char}{line}{model_code}"
+    mlb = f"{plant}{year % 10}{week:02d}{weekday}{seq}{board_code}{rev}"
+    mac = random_mac(rng)
+    hardware_uuid = uuid_from_mac(rng, mac)
+    rom = mac.replace(":", "")
+    machine_id = hashlib.sha256(f"{vm_id}:{hardware_uuid}".encode()).hexdigest()[:32]
+    hostname = f"{slug(a.model)}-{machine_id[:6]}"
+    disk_serial = "C02" + "".join(rng.choice(string.hexdigits.upper()[:16]) for _ in range(9)) if a.model != "iMac15,1" else "S29" + "".join(rng.choice(string.ascii_uppercase + string.digits) for _ in range(14))
+    return {
+        "vm_id": vm_id,
+        "source_profile": p.id,
+        "model_identifier": a.model,
+        "marketing_name": a.marketing,
+        "board_id": a.board,
+        "hostname": hostname,
+        "machine_id": machine_id,
+        "mac": mac,
