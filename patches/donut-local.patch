+//! Exit timezone lookup compatible with vm2api 1.3.208 proxy-geo.mjs.
+
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::collections::HashMap;
+use std::net::IpAddr;
+use std::sync::OnceLock;
+use std::time::Duration;
+
+pub const DEFAULT_ENDPOINT: &str = "http://ip-api.com/json/?fields=status,message,query,country,countryCode,regionName,city,timezone,isp";
+const TIMEOUT: Duration = Duration::from_secs(8);
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize)]
+pub struct ExitGeo {
+  pub ip: Option<String>,
+  pub country: Option<String>,
+  pub country_code: Option<String>,
+  pub region: Option<String>,
+  pub city: Option<String>,
+  pub isp: Option<String>,
+  pub timezone: Option<String>,
+}
+
+#[derive(Deserialize)]
+struct TimezoneAliases {
+  aliases: HashMap<String, Option<String>>,
+}
+
+pub fn valid_timezone(value: &str) -> Option<String> {
+  let value = value.trim();
+  if value.is_empty() || value.starts_with(['+', '-']) {
+    return None;
+  }
+  static ALIASES: OnceLock<TimezoneAliases> = OnceLock::new();
+  let aliases = ALIASES.get_or_init(|| {
+    serde_json::from_str(include_str!("vm2_timezone_aliases.json"))
+      .expect("bundled vm2 timezone aliases must be valid")
+  });
+  let canonical = aliases.aliases.get(&value.to_ascii_lowercase())?.clone()?;
+  canonical.parse::<chrono_tz::Tz>().ok()?;
+  Some(canonical)
+}
+
+fn text(value: Option<&Value>) -> Option<String> {
+  value
+    .filter(|value| !value.is_null())
+    .map(js_string)
+    .map(|value| value.trim().to_string())
+    .filter(|value| !value.is_empty())
+}
+
+fn js_string(value: &Value) -> String {
+  match value {
+    Value::Null => "null".into(),
+    Value::String(value) => value.clone(),
+    Value::Bool(value) => value.to_string(),
+    Value::Number(value) => value.to_string(),
+    Value::Array(values) => values
+      .iter()
+      .map(|value| {
+        if value.is_null() {
+          String::new()
+        } else {
+          js_string(value)
+        }
+      })
+      .collect::<Vec<_>>()
+      .join(","),
+    Value::Object(_) => "[object Object]".into(),
+  }
+}
+
+fn first<'a>(payload: &'a Value, keys: &[&str]) -> Option<&'a Value> {
+  keys
+    .iter()
+    .filter_map(|key| payload.get(*key))
+    .find(|value| match value {
+      Value::Null => false,
+      Value::Bool(value) => *value,
+      Value::Number(value) => value.as_f64() != Some(0.0),
+      Value::String(value) => !value.is_empty(),
+      _ => true,
+    })
+}
+
+pub fn normalize_payload(payload: &Value) -> Result<ExitGeo, String> {
+  if !payload.is_object() {
+    return Err("geo_empty_payload".into());
+  }
+  if payload
+    .get("status")
+    .and_then(Value::as_str)
+    .is_some_and(|status| status.eq_ignore_ascii_case("fail"))
+  {
+    return Err(text(payload.get("message")).unwrap_or_else(|| "geo_lookup_failed".into()));
+  }
+  let geo = ExitGeo {
+    ip: text(first(payload, &["query", "ip"])),
+    country: text(first(payload, &["country", "country_name"])),
+    country_code: text(first(payload, &["countryCode", "country_code", "country"]))
+      .map(|value| value.chars().take(8).collect()),
+    region: text(first(payload, &["regionName", "region", "region_name"])),
+    city: text(payload.get("city")),
+    isp: text(first(payload, &["isp", "org", "asn"])),
+    timezone: text(first(payload, &["timezone", "time_zone", "timeZone"]))
+      .and_then(|value| valid_timezone(&value)),
+  };
+  if geo.ip.is_none() && geo.country.is_none() && geo.timezone.is_none() {
+    return Err("geo_empty_payload".into());
+  }
+  Ok(geo)
+}
+
+fn request_url(endpoint: &str, fixed_ip: Option<&str>) -> Result<String, String> {
+  let mut url = url::Url::parse(endpoint).map_err(|_| "geo_invalid_endpoint")?;
+  if !matches!(url.scheme(), "http" | "https") || url.host_str().is_none() {
+    return Err("geo_invalid_endpoint".into());
+  }
+  if let Some(ip) = fixed_ip {
+    ip.parse::<IpAddr>().map_err(|_| "geo_invalid_ip")?;
+    if endpoint == DEFAULT_ENDPOINT {
+      url.set_path(&format!("/json/{ip}"));
+    } else if endpoint.contains("{ip}") {
+      return Ok(endpoint.replace("{ip}", &urlencoding::encode(ip)));
+    } else {
+      url.query_pairs_mut().append_pair("query", ip);
+    }
+  }
+  Ok(url.to_string())
+}
+
+fn client(proxy: Option<&str>) -> Result<reqwest::Client, String> {
+  let mut builder = reqwest::Client::builder().no_proxy().timeout(TIMEOUT);
+  if let Some(proxy) = proxy {
+    let parsed = url::Url::parse(proxy).map_err(|_| "geo_invalid_proxy")?;
+    if !matches!(
+      parsed.scheme(),
+      "http" | "https" | "socks4" | "socks4a" | "socks5" | "socks5h"
+    ) {
+      return Err("geo_unsupported_proxy".into());
+    }
+    let remote_dns = proxy.replacen("socks5://", "socks5h://", 1);
+    builder = builder.proxy(reqwest::Proxy::all(&remote_dns).map_err(|_| "geo_invalid_proxy")?);
+  }
+  builder.build().map_err(|_| "geo_client_error".into())
+}
+
+async fn lookup_at(
+  proxy: Option<&str>,
+  fixed_ip: Option<&str>,
+  endpoint: &str,
+) -> Result<ExitGeo, String> {
+  let url = request_url(endpoint, fixed_ip)?;
+  let response = client(proxy)?
+    .get(url)
+    .header(reqwest::header::ACCEPT, "application/json")
+    .send()
+    .await
+    .map_err(|_| "geo_transport_error")?;
+  if !response.status().is_success() {
+    return Err(format!("geo_http_{}", response.status().as_u16()));
+  }
+  let payload: Value = response.json().await.map_err(|_| "geo_bad_payload")?;
+  normalize_payload(&payload)
+}
+
+pub async fn lookup(proxy: Option<&str>, fixed_ip: Option<&str>) -> Result<ExitGeo, String> {
+  let endpoint = std::env::var("KIN_PROXY_GEO_URL")
+    .ok()
+    .filter(|value| !value.is_empty())
+    .unwrap_or_else(|| DEFAULT_ENDPOINT.into());
+  let result = lookup_at(proxy, fixed_ip, &endpoint).await;
+  if proxy.is_some()
+    && fixed_ip.is_none()
+    && endpoint == DEFAULT_ENDPOINT
+    && result
+      .as_ref()
+      .is_err_and(|error| error == "geo_transport_error")
+    && std::env::var("KIN_PROXY_GEO_V6_LOOKUP_MODE").as_deref() == Ok("control-plane")
+  {
+    return lookup_ipv6(proxy).await;
+  }
+  result
+}
+
+async fn lookup_ipv6(proxy: Option<&str>) -> Result<ExitGeo, String> {
+  let endpoint = std::env::var("KIN_PROXY_GEO_V6_IP_URL")
+    .unwrap_or_else(|_| "https://ipv6.icanhazip.com".into());
+  let response = client(proxy)?
+    .get(endpoint)
+    .header(reqwest::header::ACCEPT, "text/plain,*/*")
+    .send()
+    .await
+    .map_err(|_| "geo_transport_error")?;
+  if !response.status().is_success() {
+    return Err(format!("geo_ipv6_http_{}", response.status().as_u16()));
+  }
+  let body = response
+    .text()
+    .await
+    .map_err(|_| "geo_ipv6_bad_ip_payload")?;
+  let ip = body.split_whitespace().next().ok_or("geo_ipv6_empty_ip")?;
+  let address = ip
+    .parse::<std::net::Ipv6Addr>()
+    .map_err(|_| "geo_ipv6_invalid_ip")?;
+  let template = std::env::var("KIN_PROXY_GEO_V6_URL")
+    .unwrap_or_else(|_| DEFAULT_ENDPOINT.replace("/json/?", "/json/{ip}?"));
+  let endpoint = template.replace("{ip}", &urlencoding::encode(ip));
+  // This direct metadata request is opt-in and follows only a successful
+  // IPv6 exit probe through the declared proxy, matching vm2's explicit mode.
+  let mut geo = lookup_at(None, None, &endpoint).await?;
+  if geo
+    .ip
+    .as_deref()
+    .and_then(|value| value.parse::<std::net::Ipv6Addr>().ok())
+    != Some(address)
+  {
+    return Err("geo_ipv6_ip_mismatch".into());
+  }
+  geo.ip = Some(ip.into());
+  Ok(geo)
+}
+
+#[cfg(test)]
+mod tests {
