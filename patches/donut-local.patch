+      { description: "saved profile timezone" },
+    );
+    await app.waitFor(
+      () =>
+        app.execute(
+          `return !document.querySelector('[data-slot="profile-info-close"]');`,
+        ),
+      { description: "the profile editor to close after saving" },
+    );
+    await openEditor();
+    assert.equal(
+      await app.execute(
+        'return document.querySelector("#wayfern-timezone-override").value;',
+      ),
+      "Asia/Shanghai",
+    );
+    await app.fillSelector("#wayfern-timezone-override", "Unknown/Zone");
+    await app.waitForText(en.backendErrors.invalidTimezoneOverride);
+    await app.clickText(en.common.buttons.save, { exact: true });
+    assert.equal(
+      (await current()).wayfern_config.timezone_override,
+      "Asia/Shanghai",
+    );
+    await chooseSelectOption(
+      app,
+      "#wayfern-timezone-mode",
+      en.fingerprint.timezoneAutomatic,
+    );
+    await app.clickText(en.common.buttons.save, { exact: true });
+    await app.waitFor(
+      async () => !(await current()).wayfern_config.timezone_override,
+      { description: "restored automatic profile timezone" },
+    );
+    await app.waitFor(
+      () =>
+        app.execute(
+          `return !document.querySelector('[data-slot="profile-info-close"]');`,
+        ),
+      { description: "the profile editor to close after saving" },
+    );
+    await openEditor();
+    assert.equal(
+      await app.execute(
+        'return document.querySelector("#wayfern-timezone-override");',
+      ),
+      null,
+    );
+  });
+});
