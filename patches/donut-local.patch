index 0000000..efa5611
--- /dev/null
+++ b/tools/donut-fingerprint/mint_identity.mjs
@@ -0,0 +1,25 @@
+const port = process.env.PORT;
+const os = process.env.OS || 'macos';
+const wantDpr = process.env.DPR ? Number(process.env.DPR) : null;
+const base = `http://127.0.0.1:${port}`;
+let t = null;
+for (let i = 0; i < 40 && !t; i++) {
+  try { t = (await (await fetch(`${base}/json/list`)).json()).find(x => x.type === 'page'); } catch (e) {}
+  if (!t) await new Promise(r => setTimeout(r, 250));
+}
+if (!t) { try { t = await (await fetch(`${base}/json/new?about:blank`, { method: 'PUT' })).json(); } catch (e) {} }
+if (!t) { console.error('no page target'); process.exit(2); }
+const ws = new WebSocket(t.websocket || t.webSocketDebuggerUrl);
+let id = 0; const pending = new Map();
+ws.addEventListener('message', e => { const m = JSON.parse(e.data); if (m.id && pending.has(m.id)) { pending.get(m.id)(m); pending.delete(m.id); } });
+await new Promise(r => ws.addEventListener('open', r, { once: true }));
+const send = (method, params = {}) => new Promise(res => { const i = ++id; pending.set(i, res); ws.send(JSON.stringify({ id: i, method, params })); });
+let last = null;
+for (let i = 0; i < 20; i++) {
+  const r = await send('Wayfern.createIdentity', { operatingSystem: os });
+  last = r.result;
+  if (last && last.identity && (wantDpr === null || last.identity.devicePixelRatio === wantDpr)) break;
+}
+if (!last || !last.identityId) { console.error('createIdentity failed'); process.exit(3); }
+console.log(JSON.stringify({ identityId: last.identityId, identity: last.identity }));
+process.exit(0);
