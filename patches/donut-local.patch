@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Create one Donut/Wayfern profile per window, each with a fixed real-device persona."""
+from __future__ import annotations
+import argparse, json, os, shutil, signal, socket, subprocess, sys, time, urllib.request, uuid
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent
+RUNTIME = Path.home() / "Library/Application Support/DonutBrowserLocalRuntime"
+PROFILES = RUNTIME / "data/profiles"
+TEMPLATE_ID = "93a231e9-9727-4cd6-878e-c2a0487fdfce"
+WAYFERN = RUNTIME / "data/binaries/wayfern/152.0.7977.64/Wayfern.app/Contents/MacOS/Wayfern"
+NODE = Path.home() / ".local/node-v24.19.0/bin/node"
+REGISTRY = ROOT / "windows.json"
+
+def free_port():
+    s = socket.socket(); s.bind(("127.0.0.1", 0)); p = s.getsockname()[1]; s.close(); return p
+
+def wait_http(port, timeout=20):
+    end = time.time() + timeout
+    while time.time() < end:
+        try:
+            urllib.request.urlopen(f"http://127.0.0.1:{port}/json/list", timeout=1).read()
+            return True
+        except Exception:
+            time.sleep(0.3)
+    return False
+
+def mint_identity(os_name="macos", dpr=None):
+    tmp = ROOT / "tmp" / f"mint-{uuid.uuid4().hex[:8]}"
+    home = tmp / "home"; tmp.mkdir(parents=True, exist_ok=True); home.mkdir(exist_ok=True)
+    port = free_port()
+    env = {"PATH": "/usr/bin:/bin", "HOME": str(home), "CFFIXED_USER_HOME": str(home),
+           "TMPDIR": str(ROOT / "tmp") + "/", "LANG": "en_US.UTF-8"}
+    subprocess.run([str(WAYFERN), "--accept-terms-and-conditions"], env=env, capture_output=True, timeout=30)
+    p = subprocess.Popen([str(WAYFERN), "--headless=new", f"--remote-debugging-port={port}",
+                          "--remote-debugging-address=127.0.0.1", f"--user-data-dir={tmp/'profile'}",
+                          "--no-first-run", "--no-default-browser-check", "about:blank"],
+                         env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
+    try:
+        if not wait_http(port):
+            raise RuntimeError("Wayfern debugging endpoint did not start")
+        out = subprocess.check_output([str(NODE), str(ROOT / "mint_identity.mjs")],
+                                      env={**os.environ, "PORT": str(port), "OS": os_name, "DPR": str(dpr) if dpr is not None else ""}, timeout=30)
+        r = json.loads(out)
+        if "identityId" not in r or "identity" not in r:
+            raise RuntimeError(f"createIdentity failed: {out[:500]}")
+        return r["identityId"], r["identity"]
+    finally:
+        try: os.killpg(os.getpgid(p.pid), signal.SIGTERM)
+        except Exception: pass
+        try: p.wait(timeout=5)
+        except Exception: pass
+        shutil.rmtree(tmp, ignore_errors=True)
+
+def persona_overrides(p):
+    h, b, w = p["hardware"], p["browser"], p["webgl"]
+    ov = {
+        "hardwareConcurrency": h["threads"],
+        "deviceMemory": min(max(int(h.get("ram_gb", 8)), 1), 8),
+        "screenWidth": h["screen"][0], "screenHeight": h["screen"][1],
+        "screenAvailWidth": h["avail"][0], "screenAvailHeight": h["avail"][1],
+        "screenColorDepth": h.get("color_depth", 24),
+        "platform": b["platform"], "platformVersion": b["platform_version"],
+        "userAgent": b["ua"], "maxTouchPoints": 0,
+        "webglVendor": w["vendor"], "webglRenderer": w["renderer"],
+        "doNotTrack": p.get("do_not_track", "unspecified"),
+        "fonts": json.dumps(p["fonts"]),
+    }
+    if w.get("parameters"):
+        ov["webglParameters"] = json.dumps(w["parameters"])
+    return ov
+
+def make_location(p):
+    loc = {"accuracy": p["geo"].get("accuracy", 100), "language": p["locale"]["language"],
+           "languages": p["locale"]["languages"], "latitude": p["geo"]["lat"],
+           "longitude": p["geo"]["lon"], "timezone": p["locale"]["timezone"],
+           "timezoneOffset": 360}
+    return loc
+
+def load_registry():
+    if REGISTRY.exists(): return json.loads(REGISTRY.read_text())
+    return {"windows": []}
+
+def save_registry(r): REGISTRY.write_text(json.dumps(r, indent=2) + "\n")
+
+def create(args):
+    personas = {p.stem: json.loads(p.read_text()) for p in (ROOT/"personas").glob("*.json")}
+    reg = load_registry(); used = {w["persona_id"] for w in reg["windows"] if w.get("locked")}
+    if args.persona:
+        if args.persona not in personas: sys.exit(f"unknown persona: {args.persona}")
+        pid = args.persona
+    else:
+        free = [k for k in sorted(personas) if k not in used]
+        if not free: sys.exit("no free persona; add more personas")
+        pid = free[0]
+    if pid in used: sys.exit(f"persona already assigned: {pid}")
+    p = personas[pid]
+    template = PROFILES / TEMPLATE_ID
+    meta = json.loads((template/"metadata.json").read_text())
+    profile_id = str(uuid.uuid4())
+    newdir = PROFILES / profile_id
+    (newdir/"profile").mkdir(parents=True)
+    identity_id, identity = mint_identity(p.get("os", "macos"), p["hardware"].get("dpr"))
+    ov = persona_overrides(p); loc = make_location(p)
+    meta.update({
+        "id": profile_id, "name": args.name, "process_id": None, "last_launch": None,
+        "created_at": int(time.time()), "updated_at": int(time.time()),
+        "host_os": p.get("os", "macos"), "start_urls": [],
+    })
+    cfg = meta.setdefault("wayfern_config", {})
+    cfg.update({
+        "os": p.get("os", "macos"), "fingerprint": None,
+        "identity_id": identity_id, "identity_baseline": json.dumps(identity),
+        "identity_overrides": json.dumps(ov), "location": json.dumps(loc),
+        "randomize_fingerprint_on_launch": False, "timezone_override": None,
+        "screen_max_width": p["hardware"]["screen"][0], "screen_max_height": p["hardware"]["screen"][1],
+    })
+    (newdir/"metadata.json").write_text(json.dumps(meta, indent=2) + "\n")
+    prefs = {"intl": {"accept_languages": "en-US,en", "app_locale": "en-US"}}
+    (newdir/"profile"/"Preferences").write_text(json.dumps(prefs, indent=2) + "\n")
+    (newdir/"profile"/"Local State").write_text(json.dumps({"intl": {"app_locale": "en-US"}}, indent=2) + "\n")
+    (newdir/"profile"/"wayfern-identity.json").write_text(json.dumps({
+        "identityId": identity_id, "language": loc["language"], "latitude": loc["latitude"],
+        "longitude": loc["longitude"], "operatingSystem": p.get("os", "macos"),
+        "overrides": ov, "timezone": loc["timezone"],
+    }, indent=2) + "\n")
+    (newdir/"profile"/"persona.json").write_text(json.dumps(p, indent=2) + "\n")
+    reg["windows"].append({"profile_id": profile_id, "name": args.name, "persona_id": pid,
+                           "proxy_id": meta.get("proxy_id"), "locked": True,
+                           "created_at": int(time.time())})
+    save_registry(reg)
+    print(json.dumps({"profile_id": profile_id, "name": args.name, "persona_id": pid,
+                      "identity_id": identity_id, "dir": str(newdir)}, indent=2))
+
+def list_windows(_):
+    r = load_registry()
+    for w in r["windows"]:
+        print(f'{w["profile_id"]}  {w["name"]:<20}  persona={w["persona_id"]}  locked={w["locked"]}')
+
+def main():
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    c = sub.add_parser("create"); c.add_argument("--name", required=True); c.add_argument("--persona"); c.set_defaults(fn=create)
+    l = sub.add_parser("list"); l.set_defaults(fn=list_windows)
+    a = ap.parse_args(); a.fn(a)
+
+if __name__ == "__main__":
+    main()
