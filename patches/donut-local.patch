+      assert!(request.starts_with("GET http://geo.invalid/json/"));
+      let body = r#"{"status":"success","query":"203.0.113.9","countryCode":"US","timezone":"America/Phoenix"}"#;
+      socket.write_all(format!("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len()).as_bytes()).await.unwrap();
+    });
+    let proxy = format!("http://{address}");
+    let geo = lookup_at(Some(&proxy), None, "http://geo.invalid/json/")
+      .await
+      .unwrap();
+    assert_eq!(geo.timezone.as_deref(), Some("America/Phoenix"));
+    fixture.await.unwrap();
+    assert!(lookup_at(
+      Some("socks5://127.0.0.1:1"),
+      None,
+      "http://geo.invalid/json/"
+    )
+    .await
+    .is_err());
+    assert!(lookup_at(
+      Some("vless://fixture.invalid"),
+      None,
+      "http://geo.invalid/json/"
+    )
+    .await
+    .is_err());
+  }
+}
