+// Wayfern also exposes its own generated font inventory. Keep that inventory
+// consistent with the separately installed native CJK restriction. This is an
+// effective launch overlay; it never rewrites the person's stored edits.
+/// Load the process-local font policy into the engine and its helpers.
+///
+/// The engine ships CJK and emoji fallbacks; this build keeps its font
+/// inventory Latin-only, so dyld injects `DonutFontPolicy.dylib` into the
+/// browser and the library activates only when `DONUT_FONT_POLICY=latin-only`
+/// is set. A missing library is skipped rather than blocking a launch.
+fn apply_local_font_policy_env(cmd: &mut TokioCommand) {
+  #[cfg(target_os = "macos")]
+  {
+    if !cfg!(feature = "local-unrestricted") {
+      return;
+    }
+    let library = crate::app_dirs::data_dir().join("DonutFontPolicy.dylib");
+    if !library.is_file() {
+      return;
+    }
+    let mut value = library.display().to_string();
+    if let Ok(existing) = std::env::var("DYLD_INSERT_LIBRARIES") {
+      if !existing.is_empty() {
+        value.push(':');
+        value.push_str(&existing);
+      }
+    }
+    cmd.env("DYLD_INSERT_LIBRARIES", value);
+    cmd.env("DONUT_FONT_POLICY", "latin-only");
+  }
+  #[cfg(not(target_os = "macos"))]
+  let _ = cmd;
+}
+
+fn apply_local_font_inventory(config: &mut WayfernConfig, enabled: bool) {
+  if !enabled {
+    return;
+  }
+  let mut fonts = vec![
+    "Arial",
+    "Arial Black",
+    "Courier New",
+    "Georgia",
+    "Impact",
+    "Tahoma",
+    "Times New Roman",
+    "Trebuchet MS",
+    "Verdana",
+  ];
+  match config.os.as_deref().unwrap_or("macos") {
+    "windows" => fonts.extend([
+      "Calibri",
+      "Cambria",
+      "Consolas",
+      "Segoe UI",
+      "Segoe UI Emoji",
+    ]),
+    "linux" => fonts.extend([
+      "DejaVu Sans",
+      "DejaVu Serif",
+      "Liberation Sans",
+      "Liberation Mono",
+    ]),
+    _ => fonts.extend([
+      "Helvetica",
+      "Helvetica Neue",
+      "Menlo",
+      "Monaco",
+    ]),
+  }
+  let fonts = json!(fonts).to_string();
